# Copiar a .env (NO commitear) y completar con tus credenciales de DagsHub.
# Sin estas variables el proyecto usa MLflow local (sqlite:///mlflow.db).
MLFLOW_TRACKING_URI=https://dagshub.com/<usuario>/customer-churn-ml.mlflow
MLFLOW_TRACKING_USERNAME=<usuario-dagshub>
MLFLOW_TRACKING_PASSWORD=<token-dagshub>
